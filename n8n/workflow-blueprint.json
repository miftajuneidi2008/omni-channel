    {
      "parameters": {
        "jsCode": "const startTime = Date.now();\nconst body = $('Webhook').item.json.body;\nconst domain = (body.companyDomain || '').toLowerCase();\n\n// Deterministic scoring & enrichment based on domain keywords\nconst isVip =\n  domain.includes('bank') ||\n  domain.includes('fintech') ||\n  domain.includes('cloud') ||\n  domain.includes('global') ||\n  domain.includes('systems');\n\nconst vipStacks = [\n  ['Next.js', 'AWS', 'Stripe'],\n  ['React', 'AWS', 'PostgreSQL']\n];\nconst smbStacks = [\n  ['React', 'Shopify', 'Google Cloud'],\n  ['Python', 'GCP', 'Snowflake']\n];\n\nconst leadScore = isVip\n  ? Math.floor(Math.random() * 11) + 88   // 88 - 98\n  : Math.floor(Math.random() * 25) + 50;  // 50 - 74\n\nreturn [\n  {\n    json: {\n      leadId: body.leadId,\n      leadScore,\n      estimatedArr: isVip ? '$50M–$120M' : '$2M–$10M',\n      companySize: isVip ? '1,000–5,000 employees' : '50–200 employees',\n      techStack: isVip ? vipStacks[0] : smbStacks[0],\n      assignedRep: isVip ? 'Maya Chen · Enterprise AE' : 'Nurture Automation',\n      aiSummary: isVip\n        ? `High-intent enterprise account (${domain}) running a modern cloud stack. Priority outreach recommended.`\n        : `Growing SMB prospect (${domain}). Enrolled in automated product-led nurture sequence.`,\n      durationMs: Date.now() - startTime + 185\n    }\n  }\n];"
      },
